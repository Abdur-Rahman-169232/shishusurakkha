# Optional cloud services. The tracker runs fully on-device without these.

# Base44 — platform login, EPI card OCR, and voice TTS
VITE_BASE44_APP_ID=

# Firebase Auth — parallel sign-in at /firebase/login
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
